FLASK_HOST=127.0.0.1
FLASK_PORT=5001
FLASK_DEBUG=false
MAX_UPLOAD_MB=50

# 禁用 ONEDNN 修复 PaddlePaddle 3.x CPU 上 pir::ArrayAttribute 错误
FLAGS_use_onednn=0

PADDLEOCR_LANGUAGE=ch
PADDLEOCR_DEVICE=cpu
PADDLEOCR_DOC_ORIENTATION=true
PADDLEOCR_DOC_UNWARPING=false
PADDLEOCR_TEXTLINE_ORIENTATION=true

TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_LANG=chi_sim+eng
VERIFY_WITH_TESSERACT=true

EASYOCR_LANGUAGES=ch_sim,en
EASYOCR_GPU=false
EASYOCR_FALLBACK=true

OCR_MIN_CONFIDENCE=0.85
OCR_MIN_SIMILARITY=0.90
PDF_TEXT_THRESHOLD=20
PDF_OCR_DPI=300
